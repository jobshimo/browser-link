{
  "name": "browser-link-monorepo",
  "version": "0.26.0",
  "private": true,
  "description": "Monorepo workspace root for browser-link. The published npm package is @jobshimo/browser-link in packages/server.",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "build:server": "pnpm --filter @jobshimo/browser-link run build",
    "build:extension": "pnpm --filter @browser-link/extension run build",
    "dev": "pnpm run dev:server",
    "dev:server": "pnpm --filter @jobshimo/browser-link run dev",
    "try": "pnpm --filter @jobshimo/browser-link run try",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx packages/server/src/cli.ts",
    "generate:icons": "pnpm --filter @browser-link/extension run generate:icons",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,js,mjs,json}\" \"scripts/**/*.mjs\" \"*.md\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,js,mjs,json}\" \"scripts/**/*.mjs\" \"*.md\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "clean": "pnpm -r run clean",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
