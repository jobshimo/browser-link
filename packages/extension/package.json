{
  "name": "@browser-link/extension",
  "version": "1.4.7",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && node build.mjs && node copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "generate:icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@browser-link/core": "workspace:*",
    "@browser-link/shared": "workspace:*"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.7",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  }
}
