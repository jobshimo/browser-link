#!/usr/bin/env bash
#
# Pre-push reminder for browser-link releases.
#
# Fires on every `git push`. Checks whether origin/main has commits since
# the last release tag; if it does, asks whether you want to cut a release
# from the SAME push moment. Saying NO is a single Enter — the original
# push continues untouched.
#
# Saying YES asks for a bump type (patch/minor/major) and invokes
# `npm run release -- <bump>`. The release script creates a `release/vX.Y.Z`
# branch, bumps every version field across the monorepo, generates a
# CHANGELOG entry, pushes the branch, and opens a PR against main. Your
# original push proceeds afterwards.
#
# Releases ALWAYS go through a PR — this hook never bypasses branch
# protection. Tag + GitHub Release happen automatically after the PR
# merges, via .github/workflows/release-finalize.yml.
#
# Opt-in install (one time per clone):
#   git config core.hooksPath .githooks
#
# Opt-out: unset that config. Nothing breaks; the release script still
# works when invoked manually with `npm run release -- patch`.

set -e

# The pre-push protocol passes refs on stdin. We don't gate by which ref is
# being pushed — releases are cut from main state regardless of what you
# are pushing right now. We just need stdin to be drained so git doesn't
# complain.
while read -r _line; do : ; done

# Discover the repo root so we can find scripts/ and run npm from there.
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# Find the last release tag. No tag = no baseline = nothing to suggest.
LAST_TAG=$(git tag --list 'v*' --sort=-v:refname 2>/dev/null | head -n 1 || true)
if [ -z "$LAST_TAG" ]; then
  exit 0
fi

# Refresh main quietly so we count against the actual remote head.
git fetch --quiet origin main 2>/dev/null || exit 0

# Conventional commits in origin/main since the last tag — only types that
# trigger a release notes entry (feat/fix/perf/refactor/revert).
COUNT=$(git log "$LAST_TAG..origin/main" \
  --pretty=format:%s 2>/dev/null \
  | grep -E '^(feat|fix|perf|refactor|revert)(\([^)]+\))?!?:' \
  | wc -l \
  | tr -d ' ')

if [ "$COUNT" = "0" ]; then
  exit 0
fi

# Non-interactive (GUI client, IDE, CI): print a one-liner and let the push
# through. Never block. Never hang.
if [ ! -t 0 ] || [ ! -t 1 ]; then
  if [ -e /dev/tty ]; then
    : # we'll try /dev/tty below
  else
    printf '\n💡 %s unreleased commit(s) on origin/main since %s — run `npm run release -- patch` when ready.\n\n' \
      "$COUNT" "$LAST_TAG" >&2
    exit 0
  fi
fi

# Interactive prompt. Read from the controlling terminal so this works even
# when stdin/stdout are wired to git's pipe.
exec < /dev/tty

printf '\n📦 %s unreleased commit(s) on origin/main since %s.\n' "$COUNT" "$LAST_TAG"
printf 'Cut a release now? [y/N] '
read -r ANSWER

case "$ANSWER" in
  y|Y|yes|YES)
    ;;
  *)
    printf '  → skipped. Run `npm run release -- patch` later when you are ready.\n\n'
    exit 0
    ;;
esac

printf 'Bump type? [patch|minor|major] (default: patch) '
read -r BUMP
BUMP=${BUMP:-patch}

case "$BUMP" in
  patch|minor|major) ;;
  *)
    printf '  ✘ Invalid bump "%s". Skipping release.\n\n' "$BUMP"
    exit 0
    ;;
esac

printf '\n→ Running `npm run release -- %s`\n\n' "$BUMP"
npm run release -- "$BUMP"

# Allow the original push to proceed. The release ran on its own branch and
# opened its own PR — nothing we did interferes with the ref you were about
# to push.
exit 0
